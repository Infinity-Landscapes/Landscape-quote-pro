rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each business's data lives under businesses/{uid}: only that signed-in account can read
    // or write it. Nothing else in the database is reachable from the app.
    match /businesses/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{rest=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
